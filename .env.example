# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 — 공유 테이블(아티스트·앨범·일정) 쓰기용. 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SECRET_KEY=

# 외부 API 키
YOUTUBE_API_KEY=          # Google Cloud Console > YouTube Data API v3
NAVER_CLIENT_ID=          # 네이버 개발자센터 > 검색 API
NAVER_CLIENT_SECRET=
TMDB_API_KEY=             # themoviedb.org > Settings > API (드라마·영화 출연작)
KOPIS_API_KEY=            # kopis.or.kr 오픈API (콘서트 일정)
ANTHROPIC_API_KEY=        # 영수증 인식, 일정·기념일 추출 (다른 LLM으로 바꿔도 됨)

# 외부 API 호출 시 User-Agent (MusicBrainz·위키미디어 정책상 앱 이름 필수)
OCHOI_USER_AGENT="ochoi/0.1 (+https://github.com/nyng-jang/ochoi)"
